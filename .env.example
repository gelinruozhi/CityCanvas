# 高德地图 (https://console.amap.com/dev/key/app)
# Web 端 JS API Key（构建期内联进浏览器 bundle）
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
# Web 服务 Key（后端 POI 搜索用）
AMAP_REST_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 模型回退链（可选，逗号分隔）。代理网关通常按 token 绑定可用模型组，
# 按需调整即可，无需改代码；官方 API 可不填
ANTHROPIC_MODELS=

# 站点地址（OG/分享卡用，生产填真实域名，如 https://citycanvas.app）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"
