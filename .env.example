# 高德地图 (https://console.amap.com/dev/key/app)
# Web 端 JS API Key（构建期内联进浏览器 bundle）
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
# Web 服务 Key（后端 POI 搜索用）
AMAP_REST_KEY=

# AI 网关（变量名刻意不用 ANTHROPIC_*：这类名字常被用户全局环境变量占用，
# 优先级高于 .env 文件，会污染本应用；代码里 ANTHROPIC_* 仅作旧名回退）
AI_GATEWAY_API_KEY=
# anthropic 风格填到域名级（默认 https://api.anthropic.com）；
# openai 风格填到 /compatible-mode/v1 这一级
AI_GATEWAY_BASE_URL=https://api.anthropic.com
# API 风格：anthropic（默认，SDK 走 /v1/messages）| openai（网关仅提供 OpenAI 兼容
# /chat/completions 时填写）
AI_GATEWAY_API_STYLE=anthropic
# 模型回退链（可选，逗号分隔）。代理网关通常按 token 绑定可用模型组，
# 按需调整即可，无需改代码；官方 API 可不填
AI_GATEWAY_MODELS=

# 站点地址（OG/分享卡用，生产填真实域名，如 https://citycanvas.app）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"
