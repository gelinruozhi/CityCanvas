// SQLite for local dev. Switch to Postgres for production:
// provider = "postgresql"
// url = env("DATABASE_URL")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nickname  String
  avatar    String?
  createdAt DateTime @default(now())

  creations Creation[]
  comments  Comment[]
  likes     Like[]
}

model Creation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  mapView   String   // JSON string: { center: [lng, lat], zoom: number }
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  annotations Annotation[]
  comments    Comment[]
  likes       Like[]

  @@index([userId])
  @@index([createdAt])
}

model Annotation {
  id           String   @id @default(cuid())
  creationId   String
  x            Float
  y            Float
  title        String
  content      String
  buildingType String   // dining | leisure | study | sports | green | other
  // 标注形状：point（默认点位）| circle（radius 为半径米数）| rect（bounds 为对角坐标 JSON）
  shape        String   @default("point")
  radius       Float?
  bounds       String?  // JSON: { sw: [lng, lat], ne: [lng, lat] }
  // 室内标注：所属建筑与楼层（如 "图书馆" / "3F"），室外为空
  buildingName String?
  floor        String?
  aiScore      String?  // JSON string: { comfortScore, convenienceScore, overallScore, rating, summary, strengths[], concerns[], suggestions[], vibeTags[] }
  createdAt    DateTime @default(now())

  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@index([creationId])
}

model Comment {
  id         String   @id @default(cuid())
  creationId String
  userId     String
  content    String
  createdAt  DateTime @default(now())

  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creationId])
}

model Like {
  id         String   @id @default(cuid())
  creationId String
  userId     String
  createdAt  DateTime @default(now())

  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([creationId, userId])
  @@index([creationId])
}
